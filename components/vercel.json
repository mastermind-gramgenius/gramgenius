{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/selectCarousels",
      "schedule": "0 15,20,1 * * *"
    },
    {
      "path": "/api/generateCarouselImages",
      "schedule": "5 15,20,1 * * *"
    },
    {
      "path": "/api/postCarousel",
      "schedule": "15 15,20,1 * * *"
    }
  ]
}
